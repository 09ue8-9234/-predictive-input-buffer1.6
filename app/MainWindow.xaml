<Window x:Class="TestingApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:TestingApp.ViewModels"
        xmlns:ctl="clr-namespace:TestingApp.Controls"
        Title="Testing" Width="1140" Height="780" MinWidth="880" MinHeight="560"
        Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource InkBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Ideal">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="B2V" />
        <vm:InverseBoolToVisibility x:Key="NotB2V" />

        <!-- one setting: title, help text, and the control its kind needs (switch, slider + number, text) -->
        <DataTemplate DataType="{x:Type vm:SettingVM}">
            <Border Style="{StaticResource Card}" IsEnabled="{Binding CanEdit}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,16,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Title}" Style="{StaticResource H2}" TextWrapping="Wrap" />
                            <Border Visibility="{Binding PerLevel, Converter={StaticResource B2V}}" Background="{StaticResource BlueSoftBrush}"
                                    CornerRadius="8" Padding="7,1" Margin="10,0,0,0" VerticalAlignment="Center"
                                    ToolTip="Remembered per level when “Per-level settings” is on (the game keeps those values, not config.json)">
                                <TextBlock Text="per level" FontSize="11" Foreground="{StaticResource BlueBrush}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Help}" Style="{StaticResource Sub}" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button Content="↺" FontSize="16" Style="{StaticResource IconButton}" Command="{Binding ResetCommand}" ToolTip="Back to the default"
                                Visibility="{Binding IsModified, Converter={StaticResource B2V}}" />
                        <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding BoolValue, Mode=TwoWay}" Margin="8,0,0,0"
                                      Visibility="{Binding IsBool, Converter={StaticResource B2V}}" />
                    </StackPanel>
                    <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,12,0,0" Visibility="{Binding IsNumber, Converter={StaticResource B2V}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Slider Style="{StaticResource BlueSlider}" Minimum="{Binding Min}" Maximum="{Binding Max}"
                                TickFrequency="{Binding Step}" IsSnapToTickEnabled="True"
                                Value="{Binding NumValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBox Grid.Column="1" Style="{StaticResource CommitBox}" Width="80" Margin="14,0,0,0" HorizontalContentAlignment="Center"
                                 Text="{Binding NumText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                    </Grid>
                    <TextBox Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource CommitBox}" Margin="0,12,0,0" MaxLength="24" MaxWidth="320" HorizontalAlignment="Left"
                             Text="{Binding TextValue, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                             Visibility="{Binding IsText, Converter={StaticResource B2V}}" />
                </Grid>
            </Border>
        </DataTemplate>

        <!-- a settings page -->
        <DataTemplate DataType="{x:Type vm:SettingsPage}">
            <StackPanel>
                <TextBlock Text="{Binding Title}" Style="{StaticResource H1}" />
                <TextBlock Text="{Binding Blurb}" Style="{StaticResource Sub}" Margin="0,0,0,18" />
                <ItemsControl ItemsSource="{Binding Items}" />
                <TextBlock Text="Nothing matches. Try another word." Style="{StaticResource Sub}" Visibility="{Binding IsEmpty, Converter={StaticResource B2V}}" />
            </StackPanel>
        </DataTemplate>

        <!-- frame buffer -->
        <DataTemplate DataType="{x:Type vm:SlotVM}">
            <Border Style="{StaticResource Card}" IsEnabled="{Binding Ticks.CanEdit}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="36" Height="36" CornerRadius="11" Background="{StaticResource BlueSoftBrush}" VerticalAlignment="Top">
                        <TextBlock Text="{Binding Letter}" FontWeight="SemiBold" FontSize="16" Foreground="{StaticResource BlueBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="16,0">
                        <TextBox Style="{StaticResource CommitBox}" Width="220" HorizontalAlignment="Left" MaxLength="24"
                                 Text="{Binding Name.TextValue, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" ToolTip="Name of this slot" />
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="190" />
                            </Grid.ColumnDefinitions>
                            <Slider Style="{StaticResource BlueSlider}" Minimum="{Binding Ticks.Min}" Maximum="{Binding Ticks.Max}" TickFrequency="1" IsSnapToTickEnabled="True"
                                    Value="{Binding Ticks.NumValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Grid.Column="1" Text="{Binding TicksLabel}" Margin="14,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" />
                        </Grid>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="190" />
                            </Grid.ColumnDefinitions>
                            <Slider Style="{StaticResource BlueSlider}" Minimum="{Binding Wave.Min}" Maximum="{Binding Wave.Max}" TickFrequency="1" IsSnapToTickEnabled="True"
                                    Value="{Binding Wave.NumValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Grid.Column="1" Text="{Binding WaveLabel}" Margin="14,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                        </Grid>
                    </StackPanel>
                    <Button Grid.Column="2" Content="Use this slot" Style="{StaticResource GhostButton}" Command="{Binding UseCommand}" VerticalAlignment="Top" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:BufferPage}">
            <StackPanel>
                <TextBlock Text="Frame buffer" Style="{StaticResource H1}" />
                <TextBlock Style="{StaticResource Sub}" Margin="0,0,0,18"
                           Text="How early the mod may hold an input back to save the attempt. One frame is 4 ticks (240 steps per second)." />
                <Border Style="{StaticResource Card}" Padding="24,20">
                    <StackPanel>
                        <Grid>
                            <StackPanel HorizontalAlignment="Left">
                                <TextBlock Text="{Binding Headline}" FontSize="30" FontWeight="SemiBold" Foreground="{StaticResource BlueBrush}" />
                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Sub}" Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Orientation="Horizontal">
                                <TextBlock Text="Buffer" Style="{StaticResource Sub}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding BufferOn, Mode=TwoWay}" IsEnabled="{Binding CanEdit}" />
                            </StackPanel>
                        </Grid>
                        <ctl:StageRuler Margin="0,14,0,0" />
                        <TextBlock Style="{StaticResource Sub}" FontSize="12" Text="Dots are the fixed stages, the squares A–D are your custom slots (drag them). The scale is logarithmic: 0.25f to 32f." />
                        <TextBlock Text="PRESETS" Style="{StaticResource SectionLabel}" Margin="0,18,0,8" />
                        <ItemsControl ItemsSource="{Binding Presets}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding Label}" Style="{StaticResource GhostButton}" Command="{Binding Command}" ToolTip="{Binding Info}" Margin="0,0,10,0" MinWidth="100" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <TextBlock Text="CUSTOM SLOTS" Style="{StaticResource SectionLabel}" />
                <ItemsControl ItemsSource="{Binding Slots}" />
            </StackPanel>
        </DataTemplate>

        <!-- keys -->
        <DataTemplate DataType="{x:Type vm:KeyRowVM}">
            <Border Style="{StaticResource Card}" Padding="18,10" IsEnabled="{Binding CanEdit}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" Style="{StaticResource H2}" FontSize="14" />
                        <TextBlock Text="{Binding Info}" Style="{StaticResource Sub}" FontSize="12" Margin="0,2,0,0" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="{Binding DisplayText}" Command="{Binding CaptureCommand}" Margin="16,0,4,0" VerticalAlignment="Center">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource KeyCap}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCapturing}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource BlueBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Grid.Column="2" Content="✕" Style="{StaticResource IconButton}" Command="{Binding ClearCommand}" ToolTip="Remove this key"
                            Visibility="{Binding HasKey, Converter={StaticResource B2V}}" />
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:KeysPage}">
            <StackPanel>
                <TextBlock Text="Keys" Style="{StaticResource H1}" />
                <TextBlock Style="{StaticResource Sub}" Margin="0,0,0,6"
                           Text="Click a key box, then press the new key (with Ctrl, Shift or Alt if you like). Esc cancels, Backspace removes the key. These keys only work while Geometry Dash is the window in front." />
                <TextBlock Text="ACTIONS" Style="{StaticResource SectionLabel}" />
                <ItemsControl ItemsSource="{Binding Actions}" />
                <TextBlock Text="SWITCH A SETTING ON OR OFF" Style="{StaticResource SectionLabel}" />
                <ItemsControl ItemsSource="{Binding Toggles}" />
            </StackPanel>
        </DataTemplate>

        <!-- actions -->
        <DataTemplate DataType="{x:Type vm:ActionRowVM}">
            <Border Style="{StaticResource Card}" Padding="18,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" Style="{StaticResource H2}" FontSize="14" />
                        <TextBlock Text="{Binding Info}" Style="{StaticResource Sub}" FontSize="12" Margin="0,2,0,0" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding KeyText}" FontFamily="Consolas" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="16,0" />
                    <Button Grid.Column="2" Content="Run now" Style="{StaticResource GhostButton}" Command="{Binding RunCommand}" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ActionsPage}">
            <StackPanel>
                <TextBlock Text="Actions" Style="{StaticResource H1}" />
                <TextBlock Style="{StaticResource Sub}" Margin="0,0,0,18"
                           Text="Everything the mod can do on a key press. “Run now” sends it to the running game, so it needs a live connection (Connect to game, top right)." />
                <ItemsControl ItemsSource="{Binding Rows}" />
            </StackPanel>
        </DataTemplate>

        <!-- live view -->
        <DataTemplate DataType="{x:Type vm:StatRow}">
            <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="210" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" Foreground="{StaticResource MutedBrush}" />
                <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
            </Grid>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LivePage}">
            <StackPanel>
                <TextBlock Text="Live view" Style="{StaticResource H1}" />
                <TextBlock Style="{StaticResource Sub}" Margin="0,0,0,18"
                           Text="What the mod reports while the game runs (read-only). Connect to the game with the button at the top right." />
                <TextBlock Text="Not connected." Style="{StaticResource Sub}" Visibility="{Binding Host.IsLive, Converter={StaticResource NotB2V}}" />
                <Border Style="{StaticResource Card}" Visibility="{Binding Host.IsLive, Converter={StaticResource B2V}}">
                    <ItemsControl ItemsSource="{Binding Rows}" />
                </Border>
                <TextBlock Text="LOG" Style="{StaticResource SectionLabel}" />
                <Border Style="{StaticResource Card}" Padding="6">
                    <ListBox ItemsSource="{Binding Log}" Height="340" BorderThickness="0" Background="Transparent" FontFamily="Consolas" FontSize="12"
                             vm:AutoScroll.Enabled="True" Focusable="False" ScrollViewer.HorizontalScrollBarVisibility="Auto" />
                </Border>
            </StackPanel>
        </DataTemplate>

        <!-- backups -->
        <DataTemplate DataType="{x:Type vm:BackupVM}">
            <Border Style="{StaticResource Card}" Padding="18,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Sub}" FontSize="12" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Restore" Style="{StaticResource GhostButton}" Command="{Binding RestoreCommand}" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BackupsPage}">
            <StackPanel>
                <TextBlock Text="Backups and reset" Style="{StaticResource H1}" />
                <TextBlock Style="{StaticResource Sub}" Margin="0,0,0,18" Text="The app makes a copy of config.json before its first save of every session. Restoring or resetting works with the game closed." />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Mod folder" Style="{StaticResource H2}" />
                        <TextBlock Text="{Binding Folder}" Style="{StaticResource Sub}" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding FileInfo}" Style="{StaticResource Sub}" Margin="0,2,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="Open folder" Style="{StaticResource GhostButton}" Command="{Binding OpenFolderCommand}" Margin="0,0,10,0" />
                            <Button Content="Change folder…" Style="{StaticResource GhostButton}" Command="{Binding ChangeFolderCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <TextBlock Text="RESET TO DEFAULTS" Style="{StaticResource SectionLabel}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="All settings" Style="{StaticResource GhostButton}" Command="{Binding ResetSettingsCommand}" Margin="0,0,10,0" />
                        <Button Content="All keys" Style="{StaticResource GhostButton}" Command="{Binding ResetBindsCommand}" Margin="0,0,10,0" />
                        <Button Content="Everything" Style="{StaticResource GhostButton}" Command="{Binding ResetAllCommand}" />
                    </StackPanel>
                </Border>
                <TextBlock Text="CONFIG BACKUPS" Style="{StaticResource SectionLabel}" />
                <ItemsControl ItemsSource="{Binding Backups}" />
            </StackPanel>
        </DataTemplate>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- header -->
        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="24,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Border Width="36" Height="36" CornerRadius="11" Background="{StaticResource BlueBrush}">
                        <TextBlock Text="T" Foreground="White" FontWeight="Bold" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Testing" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding SchemaText}" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusText}" FontSize="12" Margin="0,0,18,0" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StatusBad}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Border CornerRadius="15" Padding="12,5" Background="#F0F4FB" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="#A8B4CC" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding GameRunning}" Value="True">
                                                <Setter Property="Fill" Value="#F2A93B" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding GameText}" FontSize="12" />
                        </StackPanel>
                    </Border>
                    <Border CornerRadius="15" Padding="12,5" Background="#F0F4FB" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="#A8B4CC" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PipeVisible}" Value="True">
                                                <Setter Property="Fill" Value="#2F6BFF" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding LiveConnected}" Value="True">
                                                <Setter Property="Fill" Value="#2DB87A" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding LinkText}" FontSize="12" />
                        </StackPanel>
                    </Border>
                    <Button Content="{Binding ConnectText}" Style="{StaticResource PrimaryButton}" Command="{Binding ConnectCommand}" Margin="0,0,16,0" />
                    <StackPanel Orientation="Horizontal" Visibility="{Binding HasConsoleLink, Converter={StaticResource B2V}}" ToolTip="Switches the game's console link (named pipe) on or off. In the game: Ctrl+F5.">
                        <TextBlock Text="Console link" FontSize="12" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding ConsoleLink.BoolValue, Mode=TwoWay}" IsEnabled="{Binding CanEdit}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- banner -->
        <Border Grid.Row="1" Padding="24,10" Visibility="{Binding ShowBanner, Converter={StaticResource B2V}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{StaticResource BlueSoftBrush}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding BannerKind}" Value="1">
                            <Setter Property="Background" Value="{StaticResource WarnSoftBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding BannerKind}" Value="2">
                            <Setter Property="Background" Value="{StaticResource ErrorSoftBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding Banner}" TextWrapping="Wrap" FontSize="13" />
        </Border>

        <!-- body -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="252" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="14,14,14,8">
                        <TextBox x:Name="SearchBox" Style="{StaticResource FieldBox}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Search settings" Foreground="{StaticResource MutedBrush}" Margin="14,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <ListBox Grid.Row="1" ItemsSource="{Binding Nav}" SelectedItem="{Binding SelectedNav, Mode=TwoWay}" ItemContainerStyle="{StaticResource NavItem}"
                             BorderThickness="0" Background="Transparent" Margin="10,0,10,10" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <ScrollViewer x:Name="PageScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ContentControl x:Name="PageHost" Content="{Binding CurrentPage}" Margin="32,26,32,44" MaxWidth="900" HorizontalAlignment="Stretch">
                    <ContentControl.RenderTransform>
                        <TranslateTransform />
                    </ContentControl.RenderTransform>
                </ContentControl>
            </ScrollViewer>
        </Grid>

        <!-- first run: choose the folder / no schema -->
        <Grid Grid.RowSpan="3" Background="#F5F8FD" Visibility="{Binding OverlayVisible, Converter={StaticResource B2V}}">
            <Border Style="{StaticResource Card}" Width="580" Padding="30" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="{Binding OverlayTitle}" Style="{StaticResource H1}" />
                    <TextBlock Text="{Binding OverlayText}" Style="{StaticResource Sub}" Margin="0,0,0,16" />
                    <ItemsControl ItemsSource="{Binding FolderChoices}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource GhostButton}" Margin="0,0,0,8" HorizontalContentAlignment="Left"
                                        Command="{Binding DataContext.PickFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                                    <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" FontWeight="Normal" />
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="Browse…" Style="{StaticResource PrimaryButton}" Command="{Binding BrowseCommand}" HorizontalAlignment="Left" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- toast -->
        <Border Grid.RowSpan="3" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,26,26" MaxWidth="460" Padding="18,12" CornerRadius="12"
                Background="#1B2433" IsHitTestVisible="False">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Opacity" Value="0" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ToastVisible}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.3" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding Toast}" Foreground="White" TextWrapping="Wrap" FontSize="13" />
        </Border>
    </Grid>
</Window>
